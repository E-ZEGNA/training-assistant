PUBLIC_BASE_URL=https://interview-api.example.com
MASTER_ENCRYPTION_KEY=
ADMIN_API_KEY=
STUDENT_TOKEN_SECRET=
STUDENT_ACTIVATION_CODES=
PERSISTENCE_QUEUE_LIMIT=1000
REQUIRE_STUDENT_PROVIDER=true

# Student-owned XiaomuAI keys are stored encrypted in DATA_DIR.
XIAOMUAI_LLM_MODEL=gpt-5.6-terra
XIAOMUAI_TIMEOUT_MS=2500

STT_PROVIDER=seed-asr
SEED_ASR_API_KEY=
SEED_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
SEED_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

LLM_PROVIDER=api
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-sol
LLM_REASONING_EFFORT=low
LLM_CONTEXT_WINDOW_TOKENS=1000000
