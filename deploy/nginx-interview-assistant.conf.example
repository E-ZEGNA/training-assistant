# Keep /v1/admin/* local-only: master-pack publishing and binding management run over SSH.
map $http_upgrade $interview_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name 119.29.213.205;

    location ^~ /.well-known/acme-challenge/ {
        root /www/wwwroot/interview-acme;
        default_type text/plain;
    }

    location / {
        return 301 https://119.29.213.205$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    server_name 119.29.213.205;

    ssl_certificate /etc/letsencrypt/live/119.29.213.205/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/119.29.213.205/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    location ^~ /v1/admin/ {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $interview_connection_upgrade;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 3m;
    }
}
