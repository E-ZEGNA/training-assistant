HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_ENCRYPTION_KEY=
ADMIN_API_KEY=
STUDENT_TOKEN_SECRET=
STUDENT_ACTIVATION_CODES=demo-code:demo-student

STT_PROVIDER=seed-asr
SEED_ASR_API_KEY=
SEED_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
SEED_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# Local test: reads the provider URL and token from the local Codex config at runtime.
# Release: set LLM_PROVIDER=api and fill the dedicated API fields below.
LLM_PROVIDER=codex-config
CODEX_CONFIG_PATH=
CODEX_AUTH_PATH=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-sol
LLM_REASONING_EFFORT=low
